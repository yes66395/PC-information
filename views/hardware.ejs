<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>硬體資訊</title>
    <style>
        ul li {
            padding-bottom:10px ;
        }
    </style>
</head>
<body>
     <h2>我的硬體資訊 </h2>
  <ul>
    <li><strong>CPU:</strong> <%= hardwareInfo.CPU %></li>
    <li><strong>MB:</strong> <%= hardwareInfo.MB %></li>
    <li><strong>RAM:</strong> <%= hardwareInfo.RAM %></li>
    <li><strong>GPU1:</strong> <%= hardwareInfo.GPU1%></li>
    <li><strong>GPU2:</strong> <%= hardwareInfo.GPU2%></li>
    <li><strong>SSD1:</strong> <%= hardwareInfo.SSD1%></li>
    <li><strong>SSD2:</strong> <%= hardwareInfo.SSD2%></li>
    <li><strong>SSD3:</strong> <%= hardwareInfo.SSD3%></li>
    <li><strong>SSD4:</strong> <%= hardwareInfo.SSD4%></li>
  </ul>


</body>
</html>